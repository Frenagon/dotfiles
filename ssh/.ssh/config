Host github.com
  hostname github.com
  identitiesOnly yes
  identityFile ~/.ssh/id_ed25519

Host *
  addKeysToAgent no
  compression no
  controlMaster no
  controlPath ~/.ssh/master-%r@%n:%p
  controlPersist no
  forwardAgent no
  hashKnownHosts no
  serverAliveCountMax 3
  serverAliveInterval 0
  userKnownHostsFile ~/.ssh/known_hosts
