[alias]
	br = branch
	ci = commit
	co = checkout
	st = status
	undo = "reset --soft HEAD^"

[branch]
	sort = -committerdate

[column]
	ui = auto

[commit]
	verbose = true

[core]
	editor = "nvim"

[delta]
	line-numbers = true
	tabs = 2

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	tool = "nvimdiff"

[fetch]
	prune = true

[init]
	defaultBranch = "main"

[interactive]
	diffFilter = "delta --color-only"

[merge]
	tool = "nvimdiff"

[pager]
	blame = "delta"
	diff = "delta"
	log = "delta"
	show = "delta"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = "current"

[rerere]
	autoupdate = true
	enabled = true

[tag]
	sort = -version:refname

[user]
	email = "frenagon@gmail.com"
	name = "Francisco Aceves"
